{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godsat.local/schemas/godsat.scene.v1.schema.json",
  "title": "GoDSAT canonical scene v1",
  "type": "object",
  "required": [
    "schema",
    "title",
    "frame",
    "units",
    "times",
    "objects",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "godsat.scene.v1"
    },
    "title": {
      "type": "string"
    },
    "frame": {
      "enum": [
        "TEME",
        "GCRS",
        "ITRS"
      ]
    },
    "units": {
      "const": "km"
    },
    "times": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1200,
      "items": {
        "type": "string",
        "format": "date-time"
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "positions_km"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "satellite",
              "sensor",
              "station"
            ]
          },
          "positions_km": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              ]
            }
          },
          "velocities_km_s": {
            "description": "Optional derivatives of position in the declared scene frame, in km/s. Enables cubic Hermite interpolation.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              ]
            }
          },
          "attitude": {
            "$ref": "godsat.attitude.v1.schema.json"
          }
        }
      }
    },
    "observations": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "detected"
                ],
                "properties": {
                  "detected": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "sensor",
                        "target"
                      ],
                      "properties": {
                        "sensor": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "cause": {
                    "type": "string"
                  },
                  "metrics": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "custody_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "saved",
            "illustrative",
            "modeled"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "$ref": "godsat.environment.v1.schema.json"
    },
    "ground_links": {
      "$ref": "godsat.ground-links.v1.schema.json"
    }
  }
}
