{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godsat.local/schemas/godsat.ground-links.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "frequency_hz",
    "stations"
  ],
  "properties": {
    "schema": {
      "const": "godsat.ground-links.v1"
    },
    "frequency_hz": {
      "type": "number",
      "minimum": 100000000.0,
      "maximum": 100000000000.0
    },
    "tec_interpolation": {
      "enum": [
        "nearest",
        "bilinear"
      ]
    },
    "tec_source_id": {
      "type": "string"
    },
    "weather_source_id": {
      "type": "string"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude_deg",
          "longitude_deg",
          "altitude_km",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "latitude_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "altitude_km": {
            "type": "number",
            "minimum": -1,
            "maximum": 10
          },
          "orthometric_height_km": {
            "type": "number",
            "minimum": -1,
            "maximum": 10
          }
        }
      }
    },
    "minimum_elevation_deg": {
      "type": "number",
      "minimum": 5,
      "maximum": 90
    },
    "shell_height_km": {
      "type": "number",
      "minimum": 200,
      "maximum": 800
    },
    "max_tec_distance_km": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "max_weather_distance_km": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "max_weather_height_difference_km": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.25
    }
  }
}
