{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godsat.local/schemas/godsat.numerical.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "frame",
    "epoch",
    "duration_seconds",
    "integration_step_seconds",
    "output_step_seconds",
    "source",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "godsat.numerical.v1"
    },
    "frame": {
      "const": "GCRS"
    },
    "epoch": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "integration_step_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 30
    },
    "output_step_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "forces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "j2": {
          "type": "boolean"
        },
        "drag": {
          "type": "boolean"
        },
        "third_bodies": {
          "type": "boolean"
        },
        "zonal_gravity": {
          "type": "boolean",
          "default": false
        },
        "solar_radiation_pressure": {
          "type": "boolean",
          "default": false
        },
        "schwarzschild": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observed",
            "modeled",
            "illustrative"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "position_gcrs_km",
          "velocity_gcrs_km_s"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "position_gcrs_km": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "velocity_gcrs_km_s": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "drag_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "drag_coefficient": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radiation_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radiation_coefficient": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "gravity_model": {
      "type": "object",
      "required": [
        "reference",
        "normalization",
        "mu_km3_s2",
        "reference_radius_km",
        "coefficients"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "const": "unnormalized_Jn"
        },
        "mu_km3_s2": {
          "type": "number",
          "exclusiveMinimum": 390000,
          "exclusiveMaximum": 410000
        },
        "reference_radius_km": {
          "type": "number",
          "exclusiveMinimum": 6300,
          "exclusiveMaximum": 6400
        },
        "coefficients": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "2": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "3": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "4": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "5": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "6": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "7": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            },
            "8": {
              "type": "number",
              "minimum": -0.01,
              "maximum": 0.01
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "forces"
        ],
        "properties": {
          "forces": {
            "required": [
              "zonal_gravity"
            ],
            "properties": {
              "zonal_gravity": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "gravity_model"
        ],
        "properties": {
          "forces": {
            "properties": {
              "j2": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "forces"
        ],
        "properties": {
          "forces": {
            "required": [
              "solar_radiation_pressure"
            ],
            "properties": {
              "solar_radiation_pressure": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "items": {
              "required": [
                "mass_kg",
                "radiation_area_m2",
                "radiation_coefficient"
              ]
            }
          }
        }
      }
    }
  ]
}
