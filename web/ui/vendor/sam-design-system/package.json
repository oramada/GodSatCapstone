{
  "name": "@sam/design-system",
  "version": "2.0.0",
  "description": "The Lanes design system, 1:1: tokens, motion, the component kit, optional backdrops and patterns. React 19 + Tailwind 4.",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css", "./src/fonts.ts"],
  "exports": {
    ".": "./src/components/ui/index.ts",
    "./styles.css": "./src/design/index.css",
    "./fonts": "./src/fonts.ts",
    "./motion": "./src/motion/index.ts",
    "./backdrops": "./src/backdrops/index.ts",
    "./patterns": "./src/patterns/index.ts",
    "./theme": "./src/design/theme.ts",
    "./keybindings": "./src/lib/keybindings/index.ts",
    "./utils": "./src/lib/utils.ts",
    "./theme-boot.js": "./boot/theme-boot.js",
    "./check": "./check/kit-check.mjs",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "sam-design-check": "./check/kit-check.mjs"
  },
  "files": ["src", "boot", "check", "dist", "COMPONENTS.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "test": "vitest run",
    "check": "node check/kit-check.mjs src --exempt src/components/ui/,src/design/,src/patterns/"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "lucide": "1.66.0",
    "lucide-react": "1.66.0",
    "morphicons": "1.7.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
