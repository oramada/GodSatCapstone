{
  "name": "godsat-studio-ui",
  "private": true,
  "type": "module",
  "description": "GoDSAT Experiment Studio's interface: React on the Sam design system (vendor/sam-design-system). Builds into web/studio/app, which the Python studio server serves.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && node scripts/stamp-build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "check": "sam-design-check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@sam/design-system": "file:./vendor/sam-design-system",
    "lucide-react": "1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
